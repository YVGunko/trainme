# Required before /activities or /archive will answer.
SERVICE_SECRET=replace-me

# Direct Neon URL without the pooler host. Do not commit a real value.
# Python on Render reads DATABASE_URL. The Next site on Vercel reads tm_DATABASE_URL.
DATABASE_URL=
tm_DATABASE_URL=

# Signs the login cookie. Vercel only. Not a password and not a scrypt parameter.
tm_SESSION_SECRET=

# The one site login. The app stores a scrypt hash; these values stay in Vercel env.
tm_AUTH_USERNAME=
tm_AUTH_PASSWORD=

# Vercel sends this as Authorization: Bearer when a cron runs. Use at least 16 random characters.
CRON_SECRET=

# Vercel server calls Render with these. Never expose them to the browser.
tm_RENDER_URL=
tm_SERVICE_SECRET=

# Any long random string. It encrypts the Garmin token stored in Neon.
TOKEN_ENCRYPTION_KEY=

# Private Vercel Blob token. The Vercel project may name its copy tm_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Token JSON from a local Garmin login, or a directory path of saved tokens.
# The free Render disk forgets files. A JSON value in GARMINTOKENS is not
# updated when the library refreshes the token.
GARMINTOKENS=
GARMIN_TOKENSTORE=

# Used only when saved tokens are missing. Do not commit real values.
GARMIN_EMAIL=
GARMIN_PASSWORD=
