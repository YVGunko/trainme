# Required before /activities will answer.
SERVICE_SECRET=replace-me

# Token JSON from a local Garmin login, or a directory path of saved tokens.
# The free Render disk forgets files. A JSON value in GARMINTOKENS is not
# updated when the library refreshes the token.
GARMINTOKENS=
GARMIN_TOKENSTORE=

# Used only when saved tokens are missing. Do not commit real values.
GARMIN_EMAIL=
GARMIN_PASSWORD=
