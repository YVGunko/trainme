# Required before /activities or /archive will answer.
SERVICE_SECRET=replace-me

# Direct Neon URL without the pooler host. Do not commit a real value.
DATABASE_URL=

# Any long random string. It encrypts the Garmin token stored in Neon.
TOKEN_ENCRYPTION_KEY=

# Private Vercel Blob token. The Vercel project may name its copy tm_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Token JSON from a local Garmin login, or a directory path of saved tokens.
# The free Render disk forgets files. A JSON value in GARMINTOKENS is not
# updated when the library refreshes the token.
GARMINTOKENS=
GARMIN_TOKENSTORE=

# Used only when saved tokens are missing. Do not commit real values.
GARMIN_EMAIL=
GARMIN_PASSWORD=
