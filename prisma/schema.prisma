generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One personal login. The site creates this row from Vercel env vars.
model users {
  id            String   @id @default(cuid())
  username      String   @unique
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
}

/// One Garmin login. The live table only allows id = 1.
model garmin_account {
  id                  Int      @id @db.SmallInt
  garmin_user_id      BigInt?
  encrypted_auth_data Bytes
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
}

/// Raw Blob object. Queryable rows point here by format, path, and hash.
model raw_object {
  id                 BigInt    @id @default(autoincrement())
  kind               String
  garmin_activity_id BigInt?
  day                DateTime? @db.Date
  source_format      String
  source_path        String
  source_sha256      String    @unique
  byte_size          Int
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
}

/// One Garmin activity, rebuilt from the stored FIT file.
model activity {
  id                   BigInt    @id @default(autoincrement())
  garmin_activity_id   BigInt    @unique
  sport                String?
  sub_sport            String?
  garmin_type_key      String?
  start_at             DateTime? @db.Timestamptz(6)
  end_at               DateTime? @db.Timestamptz(6)
  duration_sec         Float?
  moving_duration_sec  Float?
  elapsed_duration_sec Float?
  timezone_offset_min  Int?
  distance_m           Float?
  avg_hr               Float?
  max_hr               Float?
  avg_speed            Float?
  calories             Float?
  aerobic_effect       Float?
  anaerobic_effect     Float?
  training_effect_label String?
  garmin_activity_load Float?
  hr_zone_1_sec        Float?
  hr_zone_2_sec        Float?
  hr_zone_3_sec        Float?
  hr_zone_4_sec        Float?
  hr_zone_5_sec        Float?
  total_sets           Float?
  volume_kg            Float?
  est_sweat_loss_ml    Float?
  primary_benefit      String?
  recovery_heart_rate  Float?
  source               String    @default("garmin")
  source_format        String
  source_path          String
  source_sha256        String
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  running_activity running_activity?
  cycling_activity cycling_activity?
  strength_sets    strength_set[]
  fields           activity_field[]
  samples          activity_sample[]
}

model running_activity {
  activity_id                 BigInt  @id
  avg_cadence_spm             Float?
  max_cadence_spm             Float?
  avg_step_length_mm          Float?
  avg_stride_length_cm        Float?
  elevation_gain_m            Float?
  total_descent_m             Float?
  avg_ground_contact_time_ms  Float?
  avg_vertical_oscillation_cm Float?
  avg_vertical_ratio          Float?
  avg_stance_time_percent     Float?
  avg_stance_time_balance     Float?
  avg_power_w                 Float?
  max_power_w                 Float?
  normalized_power_w          Float?
  avg_respiration             Float?
  max_respiration             Float?
  total_strides               Float?
  activity                    activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
}

/// Cycling session totals, including indoor cycling. Absent sensors stay null.
model cycling_activity {
  activity_id                    BigInt  @id
  avg_power_w                    Float?
  max_power_w                    Float?
  normalized_power_w             Float?
  intensity_factor               Float?
  tss                            Float?
  avg_cadence_rpm                Float?
  max_cadence_rpm                Float?
  total_work_j                   Float?
  threshold_power_w              Float?
  left_power_pct                 Float?
  avg_left_torque_effectiveness  Float?
  avg_right_torque_effectiveness Float?
  avg_left_pedal_smoothness      Float?
  avg_right_pedal_smoothness     Float?
  avg_combined_pedal_smoothness  Float?
  total_ascent_m                 Float?
  total_descent_m                Float?
  activity                       activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
}

/// One FIT set from a strength activity.
model strength_set {
  activity_id   BigInt
  set_index     Int
  set_type      String?
  category      String?
  exercise      String?
  repetitions   Float?
  weight_kg     Float?
  duration_sec  Float?
  start_at      DateTime? @db.Timestamptz(6)
  activity      activity  @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@id([activity_id, set_index])
}

/// Every decoded FIT field except per-second record points.
model activity_field {
  activity_id   BigInt
  message       String
  message_index Int
  name          String
  ordinal       Int
  value_num     Float?
  value_text    String?
  unit          String?
  activity      activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@id([activity_id, message, message_index, name, ordinal])
}

/// Numeric fields from each FIT record point.
model activity_sample {
  activity_id BigInt
  timestamp   DateTime @db.Timestamptz(6)
  metric      String
  value       Float
  unit        String?
  activity    activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@id([activity_id, timestamp, metric])
}

/// One training day. Columns stay empty when the raw JSON does not contain them.
model daily_metrics {
  date                      DateTime @id @db.Date
  resting_hr                Float?
  overnight_hrv             Float?
  hrv_status                String?
  sleep_duration_sec        Float?
  sleep_score               Float?
  readiness_score           Float?
  readiness_level           String?
  training_status           String?
  vo2max_generic            Float?
  vo2max_cycling            Float?
  garmin_load_acute         Float?
  garmin_load_chronic       Float?
  garmin_acwr               Float?
  monthly_load_aerobic_low  Float?
  monthly_load_aerobic_high Float?
  monthly_load_anaerobic    Float?
  running_impact_load       Float?
  running_tolerance         Float?
  source_format             String
  source_path               String
  source_sha256             String
}
