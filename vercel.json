{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/garmin-today",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/garmin-today",
      "schedule": "0 18 * * *"
    }
  ],
  "functions": {
    "app/api/queue/activity-normalize/route.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "activity-normalize",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
